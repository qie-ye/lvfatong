# 律法通 V3 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== 基础配置 ====================

# 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=lvatong_dev
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long

# 智谱 AI
ZHIPU_API_KEY=your_zhipu_api_key_here

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== V3 新增配置 ====================

# 消息队列类型 (redis 或 rabbitmq)
MQ_TYPE=redis

# RabbitMQ (当 MQ_TYPE=rabbitmq 时需要)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# GPU 推理服务
GPU_ENABLED=false
GPU_SERVICE_URL=http://localhost:8081
GPU_TIMEOUT=5000

# ==================== 可选配置 ====================

# Milvus 向量数据库
MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 讯飞语音
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# 链路追踪
ZIPKIN_HOST=localhost
ZIPKIN_PORT=9411
TRACING_SAMPLING=0.0

# 文件上传
CONTRACT_UPLOAD_DIR=./uploads/contracts
